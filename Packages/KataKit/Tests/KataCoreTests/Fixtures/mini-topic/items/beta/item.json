{
  "id": "beta",
  "cards": [
    {"role": "definition", "blocks": [
      {"type": "lead", "text": "Count things in one place."},
      {"type": "p", "text": "Keep the count private and expose operations. Compare with [Alpha](kata:alpha)."}
